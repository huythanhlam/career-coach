# Supabase project URL and anon key (safe to expose — RLS protects the data)
# Find these in: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# ALLOWED_ORIGIN (server-side Supabase secret, NOT a VITE_ var): comma-separated
# allowlist of browser origins permitted to call the Edge Functions (CORS). If
# unset it falls back to "*" — fine for local dev, but set it in production:
#   supabase secrets set ALLOWED_ORIGIN="https://your-app.vercel.app"
ALLOWED_ORIGIN="https://your-app.example.com"

# Legacy AI gateway URL (used by the not-yet-migrated geminiService workflows).
# Production: the Supabase ai-generate Edge Function; local dev: the Express server.
# Removed once every workflow is on AI Core v2 (ai-gateway).
VITE_API_URL="https://your-project-ref.supabase.co/functions/v1/ai-generate"

# AI Core v2 gateway URL (ai-gateway edge function). If unset, the client derives
# it from VITE_SUPABASE_URL (…/functions/v1/ai-gateway). Runs identically in dev
# (`npm run dev:functions` → supabase functions serve) and prod.
# VITE_AI_GATEWAY_URL="https://your-project-ref.supabase.co/functions/v1/ai-gateway"

# AI_MONTHLY_TOKEN_CAP (server-side gateway secret, NOT a VITE_ var): hard monthly
# per-user token ceiling enforced before any provider call. Defaults to 2,000,000.
#   supabase secrets set AI_MONTHLY_TOKEN_CAP=2000000

# LinkedIn screenshot endpoint (optional). Defaults to the Vercel /api/screenshot
# function in production and http://localhost:4000/api/screenshot in dev.
# VITE_SCREENSHOT_URL="/api/screenshot"

# Gemini API key — get a free key at aistudio.google.com (no credit card required)
# Set this as a Supabase secret: supabase secrets set GEMINI_API_KEY=your-key-here
# Also used by the local Express server for dev
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Required for the local multi-agent dev system (agents/).
# Get your key at https://console.anthropic.com/settings/keys
# Never commit your actual key — this file is just a template
ANTHROPIC_API_KEY="sk-ant-..."

# BLS_API_KEY (optional): grounds Market Compensation salary bands in real
# government wage data (BLS OEWS). Free key — register at
# https://data.bls.gov/registrationEngine/ . Without it the BLS proxy still works
# at lower daily limits; the feature also falls back to AI estimates if absent.
# Read server-side only by the gateway (server.ts) — do NOT prefix with VITE_.
BLS_API_KEY=""

# ── Mock-interview voice (optional neural TTS) ────────────────────────────────
# Gives the AI interviewer a human-sounding voice via the gateway /api/tts proxy.
# If none of these are set, the app falls back to the browser's built-in voice.
#
# Easiest: Hugging Face hosted inference (no GPU). Get a token at
# https://huggingface.co/settings/tokens and pick a TTS model. Server-side only.
#   HF_TTS_MODEL examples: hexgrad/Kokoro-82M (most natural), facebook/mms-tts-eng
# HF_API_TOKEN="hf_..."
# HF_TTS_MODEL="hexgrad/Kokoro-82M"
#
# Alternatively, point at any HTTP TTS server you run (VibeVoice/ElevenLabs/etc.)
# that accepts { text, voice } and returns audio bytes:
# TTS_API_URL="http://localhost:5005/tts"
# TTS_API_KEY=""
# TTS_VOICE=""
#
# Frontend override (optional): where the browser sends TTS requests. Defaults to
# the local gateway (http://localhost:4000/api/tts) in dev.
# VITE_TTS_URL="http://localhost:4000/api/tts"
