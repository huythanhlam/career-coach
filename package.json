{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck:strict": "node scripts/strict-ratchet.mjs",
    "lint:eslint": "node scripts/eslint-ratchet.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "server": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env server.ts",
    "profiles:seed-list": "tsx scripts/company-profiles/seedList.ts",
    "profiles:build": "tsx scripts/company-profiles/build.ts",
    "profiles:sync": "tsx scripts/company-profiles/sync.ts",
    "profiles:refresh": "tsx scripts/company-profiles/refresh.ts",
    "blog:build": "tsx scripts/blog/build.ts",
    "blog:sync": "tsx scripts/blog/sync.ts",
    "jobs:verify-sources": "tsx scripts/verify-job-sources.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@fontsource-variable/bricolage-grotesque": "5.2.10",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/newsreader": "5.2.10",
    "@google/genai": "^1.29.0",
    "@sparticuz/chromium": "^131.0.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/cors": "^2.8.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "puppeteer-core": "^23.0.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "recharts": "^3.8.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/helmet": "^0.0.48",
    "@types/node": "^22.14.0",
    "@vercel/node": "^5.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.4",
    "shadcn": "^4.2.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.2.0",
    "vitest": "^4.1.8"
  }
