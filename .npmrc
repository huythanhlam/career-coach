# Supply-chain hardening: do not auto-run package lifecycle scripts
# (preinstall/install/postinstall) on `npm install` / `npm ci`.
# This neutralizes the primary execution vector used by npm worms
# (e.g. Shai-Hulud / Miasma), where a poisoned dependency runs
# credential-stealing code the moment it is installed.
#
# The deps in this project that ship install scripts (esbuild, fsevents,
# msw, protobufjs) do not require them for a production build — esbuild
# resolves its native binary from platform optionalDependencies.
ignore-scripts=true
